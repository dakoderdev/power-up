# Base: en desarrollo, un archivo SQLite local; en producción, la URL libsql:// de Turso y su token
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Secreto de Better Auth para firmar sesiones; en producción, uno propio y largo (openssl rand -base64 32)
AUTH_SECRET=solo-para-desarrollo-cambiar-en-produccion
BETTER_AUTH_URL=http://localhost:3000

# Usuarios de prueba que crea el seed (uno por rol)
SEED_ADMIN_EMAIL=admin@ejemplo.com
SEED_ADMIN_PASSWORD=PowerUp2026!
SEED_ADMIN_NAME=Laura Méndez
SEED_VENDEDOR_EMAIL=vendedor@ejemplo.com
SEED_VENDEDOR_PASSWORD=PowerUp2026!
SEED_VENDEDOR_NAME=Pablo Ruiz

# Opcional: solo para que el asistente cargue juegos en bloque desde IGDB; la app no las lee
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
